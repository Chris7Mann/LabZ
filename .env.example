# Resend API key used by the contact form.
# Required for POST /api/contact to send emails.
RESEND_API_KEY=

# Destination email address for messages submitted through the contact form.
# Required for POST /api/contact.
CONTACT_TO_EMAIL=

# Sender used by Resend when sending contact form emails.
# Optional: if omitted, the app uses "LabZ <onboarding@resend.dev>".
CONTACT_FROM_EMAIL=
